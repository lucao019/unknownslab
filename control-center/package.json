{
  "name": "unknowns-lab-control-center",
  "version": "0.1.0",
  "description": "Unknowns Lab — Control Center desktop para ferramentas de live e análise de inputs do PUBG",
  "main": "electron.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "dotnet publish hardware-sensor-bridge\\HardwareSensorBridge.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o hardware-sensor-bridge\\publish",
    "build": "electron-builder --win --x64"
  },
  "keywords": [],
  "dependencies": {
    "electron-store": "^10.0.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-builder@26.15.3": true,
    "electron-winstaller@5.4.0": true,
    "uiohook-napi@1.5.5": true
  },
  "build": {
    "appId": "com.lucao.unknowns-lab",
    "productName": "Unknowns Lab",
    "directories": {
      "output": "H:\\Unknowns-Lab-Build"
    },
    "files": [
      "electron.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "hardware-sensor-bridge/publish/HardwareSensorBridge.exe",
        "to": "hardware-sensor-bridge/HardwareSensorBridge.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unknowns Lab"
    },
    "portable": {
      "artifactName": "Unknowns-Lab-portable.exe"
    }
  }
}
